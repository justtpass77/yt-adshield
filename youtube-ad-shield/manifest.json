{
  "manifest_version": 3,
  "name": "AdShield for YouTube™ - Ad-Free Experience",
  "short_name": "AdShield",
  "version": "1.0.0",
  "description": "Fast, undetectable, open-source ad-blocking engine for YouTube. Fast-forwards video ads, auto-skips, bypasses anti-adblock modals, and cleans banners.",
  "homepage_url": "https://github.com/your-username/youtube-ad-shield",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AdShield for YouTube"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adshield_network_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "src/cosmetic.css"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
